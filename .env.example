# ---------------------------------------------------------------------------
# OneDrive repository sync
#
# Copy this file to .env and fill in the values IT gives you after they
# register the app in Entra ID. See ONEDRIVE_SETUP.md for what to request.
# .env is already in .gitignore -- never commit real credentials.
# ---------------------------------------------------------------------------

# Master switch. Leave false until IT has granted admin consent.
ONEDRIVE_ENABLED=false

# Log what would be uploaded without calling Microsoft Graph. Useful for
# demos and for testing the queue before credentials exist.
ONEDRIVE_DRY_RUN=false

# How files reach OneDrive.
#   graph -- upload to Microsoft Graph with the app credentials below. Works
#            on any server, but needs an Entra ID app registration.
#   local -- copy into a OneDrive folder synced by the desktop client, which
#            then uploads it. Needs no credentials at all, but only works on a
#            machine running that client. Good for development.
ONEDRIVE_MODE=graph

# local mode only: the ROOT of the synced OneDrive folder. ONEDRIVE_ROOT_FOLDER
# is appended to it, e.g.
#   C:\Users\you\OneDrive - Your School\QA Repository\CSSAO\2026\evidence.pdf
ONEDRIVE_LOCAL_PATH=

# From the Entra ID app registration overview page.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# The account whose OneDrive for Business holds the repository, e.g.
# qa-repository@sbc.edu.ph
ONEDRIVE_DRIVE_USER=

# Folder inside that OneDrive to use as the repository root.
ONEDRIVE_ROOT_FOLDER=QA Repository

# Try the upload during the web request. If this fails the file is still
# saved locally and stays queued for onedrive_worker.php to retry.
ONEDRIVE_SYNC_INLINE=true

# Seconds to wait on Graph during a web request. Keep this short so a slow
# Microsoft response never blocks a department's submission for long.
ONEDRIVE_INLINE_TIMEOUT=15

# Give up after this many failed attempts.
ONEDRIVE_MAX_ATTEMPTS=6
